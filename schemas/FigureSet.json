{
  "$defs": {
    "Dismissed": {
      "additionalProperties": false,
      "properties": {
        "doc": {
          "pattern": "^doc_[0-9a-f]{12}$",
          "title": "Doc",
          "type": "string"
        },
        "doc_type": {
          "anyOf": [
            {
              "enum": [
                "w2",
                "1099_composite",
                "1099_int",
                "1099_div",
                "1099_q",
                "1099_r",
                "1099_misc",
                "1099_nec",
                "ssa_1099",
                "1098",
                "5498",
                "5498_sa",
                "k1_1065",
                "k1_state",
                "k1_1120s",
                "k1_1041",
                "donation_ack",
                "form_8283_support",
                "payment_confirmation",
                "property_tax_bill",
                "vehicle_registration",
                "account_change_notice",
                "foreign_bank_statement",
                "fbar_filing",
                "tax_return",
                "return_paper"
              ],
              "type": "string"
            },
            {
              "pattern": "^x-[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          ],
          "title": "Doc Type"
        },
        "source": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "doc_type",
        "doc"
      ],
      "title": "Dismissed",
      "type": "object"
    },
    "Figure": {
      "additionalProperties": false,
      "properties": {
        "doc_type": {
          "anyOf": [
            {
              "enum": [
                "w2",
                "1099_composite",
                "1099_int",
                "1099_div",
                "1099_q",
                "1099_r",
                "1099_misc",
                "1099_nec",
