                "form_8283_support",
                "payment_confirmation",
                "property_tax_bill",
                "vehicle_registration",
                "account_change_notice",
                "foreign_bank_statement",
                "fbar_filing",
                "tax_return",
                "return_paper"
              ],
              "type": "string"
            },
            {
              "pattern": "^x-[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          ],
          "title": "Doc Type"
        },
        "source": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$",
          "title": "Source",
          "type": "string"
        },
        "values": {
          "description": "One per box. The first box's value lives on the year's checklist row (its Amount) when that row exists; it's stored here only when there's no such row.",
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "source",
        "doc_type",
        "values"
      ],
      "title": "Figure",
      "type": "object"
    },
    "Suggestion": {
      "additionalProperties": false,
      "description": "Values read from the year's document, waiting for the person to accept or dismiss.",
      "properties": {
        "boxes": {
          "default": [],
          "description": "The boxes read (older ones: the row's at the time)",
          "items": {
            "type": "string"
          },
          "title": "Boxes",
          "type": "array"
        },
        "checks": {
          "default": [],
          "description": "Why the values read need a look: a check of the form's arithmetic they fail (\"4 = 6.2% of 3\"), or the rules and the model read them differently",
          "items": {
            "type": "string"
          },
          "title": "Checks",
          "type": "array"
        },
        "doc": {
          "pattern": "^doc_[0-9a-f]{12}$",
          "title": "Doc",
          "type": "string"
        },
        "doc_type": {
          "anyOf": [
            {
              "enum": [
                "w2",
                "1099_composite",
                "1099_int",
                "1099_div",
