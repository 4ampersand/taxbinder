                "form_8283_support",
                "payment_confirmation",
                "property_tax_bill",
                "vehicle_registration",
                "account_change_notice",
                "foreign_bank_statement",
                "fbar_filing",
                "tax_return",
                "return_paper"
              ],
              "type": "string"
            },
            {
              "pattern": "^x-[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          ],
          "title": "Doc Type"
        },
        "pages": {
          "default": [],
          "items": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Pages",
          "type": "array"
        },
        "scanned": {
          "default": false,
          "description": "Read from a scan: check it against the paper",
          "title": "Scanned",
          "type": "boolean"
        },
        "source": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$",
          "title": "Source",
          "type": "string"
        },
        "values": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "source",
        "doc_type",
        "doc",
        "values"
      ],
      "title": "Suggestion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "`years/<year>/figures.yaml`.",
  "properties": {
    "dismissed": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Dismissed"
      },
      "title": "Dismissed",
      "type": "array"
    },
    "figures": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Figure"
      },
      "title": "Figures",
      "type": "array"
    },
    "suggested": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Suggestion"
      },
      "title": "Suggested",
      "type": "array"
    },
    "year": {
      "maximum": 2100,
      "minimum": 1990,
      "title": "Year",
      "type": "integer"
    }
  },
  "required": [
    "year"
  ],
  "title": "FigureSet",
  "type": "object"
