{
  "$defs": {
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "enum": [
            "missing_evidence",
            "change",
            "possible_inconsistency",
            "demonstrated_error"
          ],
          "title": "Classification",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "first_seen": {
          "format": "date-time",
          "title": "First Seen",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "last_seen": {
          "format": "date-time",
          "title": "Last Seen",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "params_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Params Hash"
        },
        "resolution_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution Note"
        },
        "rule": {
          "title": "Rule",
          "type": "string"
        },
        "rule_version": {
          "title": "Rule Version",
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "status": {
          "default": "open",
          "enum": [
            "open",
            "acknowledged",
            "resolved"
          ],
          "title": "Status",
          "type": "string"
        },
        "subjects": {
          "items": {
            "type": "string"
          },
          "title": "Subjects",
          "type": "array"
        },
        "suggested_action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggested Action"
        }
      },
      "required": [
        "id",
        "rule",
        "rule_version",
        "severity",
        "classification",
        "subjects",
        "message",
        "first_seen",
        "last_seen"
      ],
      "title": "Finding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Latest reconcile run for a year: `years/<year>/findings.yaml`.",
  "properties": {
    "findings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "params_hash": {
      "title": "Params Hash",
      "type": "string"
    },
    "ran_at": {
      "format": "date-time",
      "title": "Ran At",
      "type": "string"
    },
    "year": {
      "title": "Year",
      "type": "integer"
    }
  },
  "required": [
    "year",
    "ran_at",
    "params_hash"
  ],
  "title": "FindingSet",
  "type": "object"
}
