{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TaxBinder",
  "version": "0.10.0",
  "identifier": "com.4ampersand.taxbinder",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TaxBinder",
        "url": "index.html",
        "width": 1100,
        "height": 780,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "backend/": "backend/"
    },
    "macOS": {
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "minimumSystemVersion": "13.0"
    }
  }
}
